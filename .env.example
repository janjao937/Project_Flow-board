NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NATS_URL=nats://localhost:4222
JWT_SECRET=change-me

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_NATS_WS_URL=ws://localhost:8080
# Cloudflare Free web deploy: require runtime-config.json apiBaseUrl for Join
# NEXT_PUBLIC_REQUIRE_RUNTIME_API=1

# trycloudflare (docker compose -f docker/docker-compose.trycloudflare.yml up --build)
# NEXT_PUBLIC_API_URL=/api
# Allow Cloudflare-hosted web origin (comma-separated OK). * allows any origin.
# CORS_ORIGIN=https://flowboard.<account>.workers.dev
# JWT_SECRET=trycloudflare-dev-secret-change-me

# Publish trycloudflare API URL into Cloudflare KV (runtime-config) when tunnel starts
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# FLOWBOARD_CF_KV_NAMESPACE_ID=
