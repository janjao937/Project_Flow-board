# Copy to .env.trycloudflare (gitignored) for trycloudflare + Cloudflare Free Join

# Stable Cloudflare Free web origin (comma-separated OK)
CORS_ORIGIN=https://flowboard-web.<account>.workers.dev

# Optional overrides for local docker web (relative /api is default)
# NEXT_PUBLIC_API_URL=/api
JWT_SECRET=trycloudflare-dev-secret-change-me

# Publish tunnel URL into KV after start-trycloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
FLOWBOARD_CF_KV_NAMESPACE_ID=
