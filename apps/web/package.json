    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yjs": "^13.6.31",
    "zod": "^4.4.3",
