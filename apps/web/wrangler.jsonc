{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flowboard-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-31",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "RUNTIME_CONFIG",
			// Create with: npx wrangler kv namespace create RUNTIME_CONFIG
			// Then set the same id in FLOWBOARD_CF_KV_NAMESPACE_ID for tunnel publish.
			"id": "649f9ca62d4040f9ba36c6a55f45296c",
			"preview_id": "00000000000000000000000000000000"
		}
	]
}