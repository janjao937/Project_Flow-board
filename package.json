{
  "name": "flowboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:all": "node scripts/install-each.mjs",
    "dev": "concurrently -n web,api -c blue,green \"npm --prefix apps/web run dev\" \"npm --prefix apps/api run dev\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "build": "node scripts/run-each.mjs build",
    "start": "npm --prefix apps/web run start",
    "lint": "node scripts/run-each.mjs lint",
    "typecheck": "node scripts/run-each.mjs typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "trycloudflare": "node scripts/start-trycloudflare.mjs",
    "trycloudflare:stop": "docker compose -p flowboard-trycloudflare -f docker/docker-compose.trycloudflare.yml down",
    "trycloudflare:stop-tunnel": "docker compose -p flowboard-trycloudflare -f docker/docker-compose.trycloudflare.yml stop cloudflared",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up",
    "docker:dev:tunnel": "docker compose -f docker/docker-compose.dev.yml --profile trycloudflare up",
    "docker:local": "docker compose -f docker/docker-compose.local.yml up --build",
    "docker:local:down": "docker compose -f docker/docker-compose.local.yml down",
    "docker:local:reset": "docker compose -f docker/docker-compose.local.yml down -v --remove-orphans",
    "docker:trycloudflare": "node scripts/start-trycloudflare.mjs",
    "docker:staging": "docker compose -f docker/docker-compose.staging.yml up --build -d",
    "docker:staging:tunnel": "docker compose -f docker/docker-compose.staging.yml --profile tunnel up --build -d",
    "runtime-config:publish": "node scripts/publish-runtime-config.mjs",
    "cf:deploy:web": "npm --prefix apps/web run cf:deploy",
    "cf:preview:web": "npm --prefix apps/web run cf:preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
